# Application
NODE_ENV=development
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Stable base64 32-byte key for self-hosted Server Actions.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# PostgreSQL
DATABASE_URL=postgresql://warehouse_app:replace-me@localhost:5432/ahso_warehouse_demo?schema=public

# SMTP
SMTP_HOST=replace-me
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=AHSO Warehouse <no-reply@example.com>

# Internal scheduled jobs
INTERNAL_JOB_SECRET=replace-with-a-random-secret-at-least-32-characters

# Demo lifecycle
DEMO_DURATION_DAYS=30
DEMO_GRACE_DAYS=7
UNVERIFIED_ACCOUNT_RETENTION_DAYS=7
SUPPORT_SESSION_MINUTES=30
