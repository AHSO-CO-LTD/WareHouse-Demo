generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String               @id
  name                  String
  email                 String
  emailVerified         Boolean              @default(false)
  image                 String?
  phoneNumber           String?              @unique
  companyName           String?
  birthYear             Int?
  termsAcceptedAt       DateTime?
  privacyAcceptedAt     DateTime?
  termsVersion          String?
  privacyVersion        String?
  marketingEmailConsent Boolean              @default(false)
  mustChangePassword    Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  role                  String?
  banned                Boolean?             @default(false)
  banReason             String?
  banExpires            DateTime?
  sessions              Session[]
  accounts              Account[]
  workspace             Workspace?
  supportStarts         SupportSession[]     @relation("SupportActor")
  auditEvents           AuditLog[]           @relation("AuditActor")
  settingEdits          PlatformSetting[]    @relation("SettingEditor")
  emailDeliveries       EmailDelivery[]
  productCostChanges    ProductCostHistory[] @relation("ProductCostChangeActor")
  inventoryDocuments    InventoryDocument[]  @relation("InventoryDocumentActor")

  @@unique([email])
  @@map("user")
}

enum WorkspaceStatus {
  ONBOARDING
  ACTIVE
  READ_ONLY
  PURGE_PENDING
  PURGED
}

enum StorageClass {
  LIGHT
  MEDIUM
  HEAVY
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryDocumentType {
  OPENING
  RECEIPT
  ISSUE
}

enum InventoryBalanceStatus {
  AVAILABLE
}

enum LocationCodeKind {
  WAREHOUSE
  ZONE
  RACK
  RACK_LEVEL
  SLOT
}

enum AppLocale {
  VI
  EN
}

enum AppTheme {
  LIGHT
  DARK
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING_EMAIL
}

enum SupportSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum TransactionalEmailType {
  EMAIL_VERIFIED_WELCOME
  DEMO_ACTIVATED
  PASSWORD_CHANGED
}

model Workspace {
  id           String          @id @default(uuid()) @db.Uuid
  ownerUserId  String          @unique
  owner        User            @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  displayName  String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  locale       AppLocale       @default(VI)
  theme        AppTheme        @default(LIGHT)
  status       WorkspaceStatus @default(ONBOARDING)
  startedAt    DateTime?
  expiresAt    DateTime?
  lockedAt     DateTime?
  purgeAt      DateTime?
  purgedAt     DateTime?
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  limits             WorkspaceLimit?
  consents           ConsentRecord[]
  supportSessions    SupportSession[]
  auditEvents        AuditLog[]
  emailDeliveries    EmailDelivery[]
  warehouses         Warehouse[]
  zones              Zone[]
  racks              Rack[]
  rackLevels         RackLevel[]
  slots              Slot[]
  locationCodes      LocationCodeRegistry[]
  units              Unit[]
  products           Product[]
  inventoryLots      InventoryLot[]
  productCostHistory ProductCostHistory[]
  inventoryDocuments InventoryDocument[]
  inventoryLines     InventoryDocumentLine[]
  inventoryLedger    InventoryLedgerEntry[]
  inventoryBalances  InventoryBalance[]

  @@index([status, expiresAt])
  @@index([status, purgeAt])
  @@map("workspace")
}

model WorkspaceLimit {
  id                        String    @id @default(uuid()) @db.Uuid
  workspaceId               String    @unique @db.Uuid
  workspace                 Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  durationDays              Int       @default(30)
  graceDays                 Int       @default(7)
  warehouseLimit            Int       @default(1)
  zonesPerWarehouseLimit    Int       @default(2)
  racksPerZoneLimit         Int       @default(3)
  levelsPerRackLimit        Int       @default(3)
  slotsPerLevelLimit        Int       @default(2)
  productLimit              Int       @default(20)
  projectLimit              Int       @default(5)
  partyProfileLimit         Int       @default(5)
  supplierLimit             Int       @default(5)
  commercialDocumentLimit   Int       @default(10)
  inventoryTransactionLimit Int       @default(100)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@map("workspace_limit")
}

model Warehouse {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @db.Uuid
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code         String
  name         String
  description  String?
  storageClass StorageClass?
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  zones Zone[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, code])
  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
  @@map("warehouse")
}

model Zone {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @db.Uuid
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  warehouseId  String        @db.Uuid
  warehouse    Warehouse     @relation(fields: [warehouseId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  code         String
  name         String
  description  String?
  storageClass StorageClass?
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  racks Rack[]

  @@unique([id, workspaceId])
  @@unique([warehouseId, code])
  @@unique([warehouseId, name])
  @@index([workspaceId, warehouseId])
  @@map("zone")
}

model Rack {
  id                   String        @id @default(uuid()) @db.Uuid
  workspaceId          String        @db.Uuid
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  zoneId               String        @db.Uuid
  zone                 Zone          @relation(fields: [zoneId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  code                 String
  name                 String
  description          String?
  storageClass         StorageClass?
  configuredLevelCount Int           @default(1)
  version              Int           @default(1)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  levels RackLevel[]

  @@unique([id, workspaceId])
  @@unique([zoneId, code])
  @@unique([zoneId, name])
  @@index([workspaceId, zoneId])
  @@map("rack")
}

model RackLevel {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @db.Uuid
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rackId       String        @db.Uuid
  rack         Rack          @relation(fields: [rackId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  code         String
  sequence     Int
  name         String
  storageClass StorageClass?
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  slots Slot[]

  @@unique([id, workspaceId])
  @@unique([rackId, code])
  @@unique([rackId, name])
  @@unique([rackId, sequence])
  @@index([workspaceId, rackId])
  @@map("rack_level")
}

model LocationCodeRegistry {
  workspaceId  String           @db.Uuid
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code         String
  locationType LocationCodeKind
  locationId   String           @db.Uuid
  createdAt    DateTime         @default(now())

  @@id([workspaceId, code])
  @@unique([workspaceId, locationType, locationId])
  @@index([workspaceId, locationType])
  @@map("location_code_registry")
}

model Slot {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @db.Uuid
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rackLevelId  String        @db.Uuid
  rackLevel    RackLevel     @relation(fields: [rackLevelId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  code         String
  name         String
  storageClass StorageClass?
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  inventoryLines    InventoryDocumentLine[]
  inventoryLedger   InventoryLedgerEntry[]
  inventoryBalances InventoryBalance[]

  @@unique([workspaceId, code])
  @@unique([id, workspaceId])
  @@unique([rackLevelId, code])
  @@unique([rackLevelId, name])
  @@index([workspaceId, rackLevelId])
  @@map("slot")
}

model Unit {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sequence    Int
  code        String
  name        String
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  baseProducts   Product[]               @relation("ProductBaseUnit")
  conversions    ProductUnitConversion[]
  inventoryLines InventoryDocumentLine[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, sequence])
  @@unique([workspaceId, code])
  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
  @@map("unit")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  barcode     String?
  status      ProductStatus @default(ACTIVE)
  baseUnitId  String        @db.Uuid
  baseUnit    Unit          @relation("ProductBaseUnit", fields: [baseUnitId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  currentCost Decimal       @default(0) @db.Decimal(18, 2)
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  conversions       ProductUnitConversion[]
  lots              InventoryLot[]
  costHistory       ProductCostHistory[]
  inventoryLines    InventoryDocumentLine[]
  inventoryLedger   InventoryLedgerEntry[]
  inventoryBalances InventoryBalance[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, code])
  @@unique([workspaceId, name])
  @@unique([workspaceId, barcode])
  @@index([workspaceId, status, createdAt])
  @@map("product")
}

model ProductUnitConversion {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  unitId      String   @db.Uuid
  unit        Unit     @relation(fields: [unitId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  factor      Decimal  @db.Decimal(24, 8)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, unitId])
  @@index([workspaceId, productId])
  @@map("product_unit_conversion")
}

model InventoryLot {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId       String    @db.Uuid
  product         Product   @relation(fields: [productId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  sequence        Int
  code            String
  supplierLotCode String?
  manufacturedAt  DateTime? @db.Date
  expiresAt       DateTime? @db.Date
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  inventoryLines    InventoryDocumentLine[]
  inventoryLedger   InventoryLedgerEntry[]
  inventoryBalances InventoryBalance[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, code])
  @@unique([productId, sequence])
  @@index([workspaceId, productId, expiresAt])
  @@map("inventory_lot")
}

model InventoryDocument {
  id             String                @id @default(uuid()) @db.Uuid
  workspaceId    String                @db.Uuid
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sequence       Int
  code           String
  type           InventoryDocumentType
  idempotencyKey String
  actorUserId    String
  actor          User                  @relation("InventoryDocumentActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  postedAt       DateTime              @default(now())
  createdAt      DateTime              @default(now())

  lines InventoryDocumentLine[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, sequence])
  @@unique([workspaceId, code])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, type, postedAt])
  @@map("inventory_document")
}

model InventoryDocumentLine {
  id               String            @id @default(uuid()) @db.Uuid
  workspaceId      String            @db.Uuid
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId       String            @db.Uuid
  document         InventoryDocument @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  lineNumber       Int
  productId        String            @db.Uuid
  product          Product           @relation(fields: [productId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  lotId            String?           @db.Uuid
  lot              InventoryLot?     @relation(fields: [lotId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  slotId           String            @db.Uuid
  slot             Slot              @relation(fields: [slotId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  inputUnitId      String            @db.Uuid
  inputUnit        Unit              @relation(fields: [inputUnitId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  inputUnitCode    String
  inputUnitName    String
  conversionFactor Decimal           @db.Decimal(24, 8)
  inputQuantity    Decimal           @db.Decimal(24, 8)
  baseQuantity     Decimal           @db.Decimal(24, 8)
  unitCost         Decimal           @db.Decimal(18, 2)
  createdAt        DateTime          @default(now())

  ledgerEntry InventoryLedgerEntry?

  @@unique([id, workspaceId])
  @@unique([documentId, lineNumber])
  @@index([workspaceId, productId, slotId])
  @@map("inventory_document_line")
}

model InventoryLedgerEntry {
  id                 BigInt                 @id @default(autoincrement())
  workspaceId        String                 @db.Uuid
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentLineId     String                 @db.Uuid
  documentLine       InventoryDocumentLine  @relation(fields: [documentLineId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  productId          String                 @db.Uuid
  product            Product                @relation(fields: [productId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  lotId              String?                @db.Uuid
  lot                InventoryLot?          @relation(fields: [lotId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  slotId             String                 @db.Uuid
  slot               Slot                   @relation(fields: [slotId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  status             InventoryBalanceStatus @default(AVAILABLE)
  signedBaseQuantity Decimal                @db.Decimal(24, 8)
  occurredAt         DateTime               @default(now())

  @@unique([documentLineId, workspaceId])
  @@index([workspaceId, productId, lotId, slotId, occurredAt])
  @@index([workspaceId, slotId, occurredAt])
  @@map("inventory_ledger_entry")
}

model InventoryBalance {
  id          String                 @id @default(uuid()) @db.Uuid
  workspaceId String                 @db.Uuid
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId   String                 @db.Uuid
  product     Product                @relation(fields: [productId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  lotId       String?                @db.Uuid
  lot         InventoryLot?          @relation(fields: [lotId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  lotKey      String
  slotId      String                 @db.Uuid
  slot        Slot                   @relation(fields: [slotId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  status      InventoryBalanceStatus @default(AVAILABLE)
  quantity    Decimal                @default(0) @db.Decimal(24, 8)
  version     Int                    @default(1)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([workspaceId, productId, lotKey, slotId, status])
  @@index([workspaceId, productId, status])
  @@index([workspaceId, slotId, status])
  @@map("inventory_balance")
}

model ProductCostHistory {
  id           BigInt    @id @default(autoincrement())
  workspaceId  String    @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId    String    @db.Uuid
  product      Product   @relation(fields: [productId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  actorUserId  String?
  actor        User?     @relation("ProductCostChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  previousCost Decimal?  @db.Decimal(18, 2)
  nextCost     Decimal   @db.Decimal(18, 2)
  occurredAt   DateTime  @default(now())

  @@index([workspaceId, productId, occurredAt])
  @@map("product_cost_history")
}

model ConsentRecord {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        ConsentType
  granted     Boolean
  policyKey   String
  policyVer   String
  source      String
  ipAddress   String?
  userAgent   String?
  recordedAt  DateTime    @default(now())

  @@index([workspaceId, type, recordedAt])
  @@map("consent_record")
}

model SupportSession {
  id              String               @id @default(uuid()) @db.Uuid
  workspaceId     String               @db.Uuid
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  startedByUserId String
  startedBy       User                 @relation("SupportActor", fields: [startedByUserId], references: [id], onDelete: Restrict)
  reason          String
  status          SupportSessionStatus @default(ACTIVE)
  startedAt       DateTime             @default(now())
  expiresAt       DateTime
  endedAt         DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  auditEvents AuditLog[]

  @@index([workspaceId, status, expiresAt])
  @@index([startedByUserId, startedAt])
  @@map("support_session")
}

model AuditLog {
  id               BigInt          @id @default(autoincrement())
  workspaceId      String?         @db.Uuid
  workspace        Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actorUserId      String?
  actor            User?           @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  supportSessionId String?         @db.Uuid
  supportSession   SupportSession? @relation(fields: [supportSessionId], references: [id], onDelete: SetNull)
  action           String
  resource         String
  resourceId       String?
  result           AuditResult
  reason           String?
  before           Json?
  after            Json?
  metadata         Json?
  requestId        String?
  ipAddress        String?
  userAgent        String?
  occurredAt       DateTime        @default(now())

  @@index([workspaceId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([resource, resourceId, occurredAt])
  @@index([requestId])
  @@map("audit_log")
}

model PlatformSetting {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  value           Json
  description     String?
  updatedByUserId String?
  updatedBy       User?    @relation("SettingEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedByUserId])
  @@map("platform_setting")
}

model EmailDelivery {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String?
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId    String?                @db.Uuid
  workspace      Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  recipient      String
  type           TransactionalEmailType
  idempotencyKey String                 @unique
  status         EmailDeliveryStatus    @default(PENDING)
  attemptCount   Int                    @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  failureCode    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([userId, type, createdAt])
  @@index([workspaceId, type, createdAt])
  @@map("email_delivery")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
